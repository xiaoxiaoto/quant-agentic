[importlinter]
root_package = src

[importlinter:contract:layers]
name = Layered architecture (Contracts | Configs → Repo → Agents → Services → Runtime → Routers)
type = layers
layers =
    src.routers
    src.runtime
    src.services
    src.agents
    src.repositories
    src.contracts | src.configs
# `layers` 自顶向下读取：每项可导入其下方列出的层。
# 同一行用 | 分隔的包处于同一层，互不可见。
# Order: contracts|configs → repositories → agents → services → runtime → routers

# Add explicit pair-wise exemptions here only when truly unavoidable.
# Example:
# ignore_imports =
#     src.routers.health -> src.runtime.scheduler
