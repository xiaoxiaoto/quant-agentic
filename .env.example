# ==============================================================================
# 基础应用配置 (Application Settings)
# ==============================================================================
NAME=quant-agentic

# ==============================================================================
# 服务与网络配置 (Server & Network Settings)
# ==============================================================================
HOST=127.0.0.1
PORT=8000
DEBUG=false
# 可选 API 访问令牌；设置后 /api/v1/* 需携带 Authorization: Bearer <token> 或 X-API-Key
API_AUTH_TOKEN=
# 可选允许跨域写请求的 Origin 白名单 JSON 数组，例如 ["http://127.0.0.1:5173"]
ALLOWED_ORIGINS=[]

# ==============================================================================
# 行情数据与监控配置 (Market Data & Quality Settings)
# ==============================================================================
DATA_DIR=data
STALE_QUOTE_THRESHOLD_SECONDS=30.0
SPREAD_ANOMALY_THRESHOLD=0.01

# ==============================================================================
# 京东客户端（凭证仅用于需要授权的查询，不内置共享密钥）
# ==============================================================================
JD_BFF_BASE_URL=https://ms.jr.jd.com/gw2/generic/cfGoldAi/pc/m
JD_PUBLIC_BASE_URL=https://ms.jr.jd.com/gw2/generic/ugActs/h5/m
JD_GATEWAY_BASE_URL=https://youqian.jd.com/api/gateway
JD_LATEST_PRICE_URL=https://api.jdjygold.com/gw/generic/hj/h5/m/latestPrice
# 可选外部凭据；浏览器授权并使用 SQLite 登录态时留空
JD_ACCESS_TOKEN=
JD_GATEWAY_API_KEY=
JD_CLAW=
JD_PROACTIVE_AUTH_ENABLED=true
JD_TIMEOUT_SECONDS=10

# ==============================================================================
# 京东账号到期前浏览器自动续约 (JD Auto-Renew Browser Settings)
# ==============================================================================
# 默认在令牌到期前 30 分钟（1800 秒）通过 Playwright 自动续约；默认使用本地持久化浏览器 Profile
JD_AUTO_RENEW_ENABLED=true
JD_AUTO_RENEW_LEAD_SECONDS=1800
# 留空时默认使用本地持久化浏览器 Profile（DATA_DIR/jd-browser-profile）；填写地址时改为连接本机 Chrome CDP
JD_AUTO_RENEW_CDP_URL=
# 持久化 Profile 模式下的无头开关（true 为后台无头，false 或 CLI --headed 为有头排障）
JD_AUTO_RENEW_HEADLESS=true
# 持久化 Profile 目录（留空默认位于 DATA_DIR/jd-browser-profile，自动设置 0700 权限）
JD_AUTO_RENEW_PROFILE_DIR=
JD_AUTO_RENEW_TIMEOUT_SECONDS=45
JD_AUTO_RENEW_COOLDOWN_SECONDS=180
JD_AUTO_RENEW_MAX_ATTEMPTS=3
# 可选京东登录账号密码（仅存本机 .env，禁止提交仓库；遇登录页时自动填充，遇验证码立即中止）
JD_LOGIN_USERNAME=
JD_LOGIN_PASSWORD=
JD_AUTO_RENEW_CONFIRM_SELECTORS=["button:has-text('确认授权')","button:has-text('同意授权')","button:has-text('授权登录')","button:has-text('立即授权')","button:has-text('允许')","a:has-text('确认授权')","a:has-text('同意授权')"]

# ==============================================================================
# 多品种实时参考行情采集（非可成交双边报价）
# ==============================================================================
LIVE_QUOTES_ENABLED=true
LIVE_QUOTES_INTERVAL_SECONDS=10
# 默认采集全部品种；可用 JSON 数组指定后台轮询子集，例如 ["CMBC-JCJ","SGE-Au99.99"]。
LIVE_QUOTES_PRODUCTS=null

# ==============================================================================
# 京东实盘持仓后台同步 (JD Holdings Sync)
# ==============================================================================
JD_HOLDINGS_SYNC_ENABLED=true
JD_HOLDINGS_SYNC_INTERVAL_SECONDS=60

# ==============================================================================
# 多周期 K 线与分时数据后台采集 (Market Bars & Time-Sharing)
# ==============================================================================
MARKET_BARS_ENABLED=true
MARKET_BARS_INTERVAL_SECONDS=60
MARKET_KLINE_PRODUCTS=["CMBC-JCJ","SGE-Au99.99","WG-JDAU","WG-XAUUSD"]
MARKET_KLINE_INTERVALS=["m1","m5","m15","m30","m60","day","week","month","year"]
MARKET_TIMESHARING_INTERVALS=["m1","m5"]

# ==============================================================================
# 交易与费率配置 (Trading & Fee Settings)
# ==============================================================================
BUY_FEE_RATE=0.0
SELL_FEE_RATE=0.004
DEFAULT_PRODUCT_CODE=GOLD_ACCUMULATION
DEFAULT_TRADE_GRAMS=2.0
DEFAULT_INITIAL_CASH=100000.0

# ==============================================================================
# 模拟盘参考价合成、实盘参考价辅助与风控门禁配置
# ==============================================================================
# 仅用于本地模拟盘研究，实盘决策默认强制排除合成报价
SYNTHETIC_PAPER_QUOTE_ENABLED=false
SYNTHETIC_PAPER_REFERENCE_PRODUCT=CMBC-JCJ
SYNTHETIC_PAPER_SPREAD_PCT=0.002
# 显式开启后，无真实双边报价时允许基于 CNY/g 参考价按估算点差生成「人工复核辅助提醒」（严禁自动下单）
LIVE_REFERENCE_ASSIST_ENABLED=false
LIVE_REFERENCE_SPREAD_PCT=0.002
# 特征基差自动联动基准品种（须为 CNY/g 计价参考品种，默认上金所 Au99.99）
BASIS_REFERENCE_PRODUCT=SGE-Au99.99
DAILY_LOSS_TRIGGER_PCT=0.01
WEEKLY_LOSS_TRIGGER_PCT=0.03
SIGNAL_COOLDOWN_SECONDS=0.0

# ==============================================================================
# LightGBM 训练产物（留空时使用明确标记的启发式研究模式）
# ==============================================================================
LIGHTGBM_MODEL_DIR=

# ==============================================================================
# Qlib 离线量化研究与模型配置 (Qlib Quantitative Research Settings)
# ==============================================================================
# 预测后端选择：auto（依次 qlib_model_dir、lightgbm_model_dir、timesfm_model_dir，均为空时启发式）/ lightgbm / qlib / timesfm / heuristic
PREDICTOR_BACKEND=auto
QLIB_ENABLED=false
# 本地 SQLite 导出的自定义黄金 Qlib 二进制数据目录
QLIB_PROVIDER_URI=data/qlib_data
# 可选外部标准 Qlib 数据源目录（例如黄金 ETF 或 A 股行情目录）
QLIB_EXTERNAL_PROVIDER_URI=
QLIB_REGION=cn
# Qlib 训练并校准导出的推理产物目录（留空时不启用 Qlib 线上预测）
QLIB_MODEL_DIR=
# Qlib 本地实验记录与元数据存储目录
QLIB_EXPERIMENT_DIR=data/qlib_experiments
# Au99.99 单标的择时默认开平仓阈值、交易单位（克/手）与离线宏观 CSV 容灾目录
QLIB_AU9999_BUY_THRESH=0.001
QLIB_AU9999_SELL_THRESH=-0.0005
QLIB_AU9999_TRADE_UNIT_GRAMS=10.0
QLIB_MACRO_CSV_DIR=

# ==============================================================================
# TimesFM 3.0 本地推理（下载权重仅限许可允许的非商业研究用途）
# ==============================================================================
TIMESFM_ENABLED=true
TIMESFM_CHECKPOINT=google/timesfm-3.0-pytorch
TIMESFM_DEVICE=auto
TIMESFM_CONTEXT_LENGTH=512
# TimesFM 多因子训练导出的推理产物目录（PREDICTOR_BACKEND=timesfm 时必填；留空不启用）
TIMESFM_MODEL_DIR=
# TimesFM 多因子数据集与实验记录目录
TIMESFM_DATASET_DIR=data/timesfm_datasets
TIMESFM_EXPERIMENT_DIR=data/timesfm_experiments

# ==============================================================================
# OpenAI 兼容大模型服务 (OpenAI-Compatible LLM Settings)
# ==============================================================================
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=30

# ==============================================================================
# 新闻风险分析与 Agent (News Risk & Agent Settings)
# ==============================================================================
NEWS_ENABLED=true
# 定时采集京东资讯原文；启用 News LLM 时另外提取新闻风险
NEWS_SYNC_ENABLED=true
NEWS_SYNC_INTERVAL_SECONDS=300
NEWS_SYNC_PAGE_SIZE=10
